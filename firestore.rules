rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 시간표: 누구나 읽기 가능(링크만 있으면 됨), 쓰기는 로그인(관리자)한 경우만
    match /schedules/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 공지사항: 동일
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 게시판: 누구나 읽기/작성/삭제 가능(삭제 시 비밀번호는 클라이언트에서 확인),
    // 관리자 답변(update)은 로그인한 관리자만 가능
    match /posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
      // 관리자(로그인)는 전체 수정 가능(답변 등록 포함).
      // 비로그인 사용자는 비밀번호 확인 후 자기 글의 제목/내용/사진/작성자정보/비밀번호만 수정 가능(답변, 게시판 종류는 수정 불가)
      allow update: if request.auth != null
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'content', 'imageData', 'anonymous', 'name', 'country', 'passwordHash', 'updatedAt']);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if request.auth != null;
      }
    }
    // 버스 예약: 누구나 읽기/생성/취소(삭제) 가능(취소 시 이름+국가는 클라이언트에서 확인),
    // 예약 정보 수정(관리자가 인원수 등 변경)은 로그인한 관리자만 가능
    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
      allow update: if request.auth != null;
    }
  }
}
